#!/usr/bin/env python3

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Apply the settings that must follow the cluster configuration to every
# realm managed by the module. It runs after every Keycloak start, and
# when such settings change, because events can be lost:
#
# - the LDAP federation follows the user domain settings, and federated
#   IdPs of earlier versions are removed;
# - a module client exists only while the module is bound to the user
#   domain of the realm;
# - the SMTP settings follow the node smarthost;
# - the access policies of the clients are complete.
#

import os
import sys

import agent
import agent.ldapproxy
import idpaccess
import idpcert
import idplegacy
import idprealm
import kcadmin

def smtp_server_rep(settings):
    """Map the node smarthost settings to a realm smtpServer
    representation. The TLS certificate verification is a server-wide
    setting of Keycloak and it is not mapped."""
    if not settings["enabled"] or not settings["host"]:
        return {}
    rep = {
        "host": settings["host"],
        "port": str(settings["port"]),
        "from": os.environ.get("IDP_SMTP_FROM") or "no-reply@" + os.environ["IDP_HOSTNAME"],
        "fromDisplayName": "Single Sign-On",
        "starttls": "true" if settings["encrypt_smtp"] == "starttls" else "false",
        "ssl": "true" if settings["encrypt_smtp"] == "tls" else "false",
        "auth": "true" if settings["username"] else "false",
    }
    if settings["username"]:
        rep["user"] = settings["username"]
        rep["password"] = settings["password"]
    return rep

# Registrations and client changes modify the same realms: concurrent
# updates of the LDAP federation fail with an optimistic lock error
with idprealm.realms_lock():
    # The HTTP listener can precede completion of model bootstrap during
    # upgrades. Its 503 phase exceeds the short per-request retry budget.
    kcadmin.wait_ready()

    rdb = agent.redis_connect()
    smtp_server = smtp_server_rep(agent.get_smarthost_settings(rdb))

    user_domains = agent.ldapproxy.Ldapproxy().get_domains_list()

    kc = kcadmin.agent_client()
    certificate_realms = []
    for realm in kcadmin.managed_realms(kc):
        if realm in user_domains:
            try:
                # Realms of earlier versions may still have federated IdPs
                idplegacy.remove_federated_idps(kc, realm, idprealm.LDAP_COMPONENT_NAME, idprealm.ensure_federation)
            except Exception as ex:
                # Try again at the next start; the other realms and settings
                # are still applied
                print(agent.SD_WARNING + f"Cannot remove the federated IdPs of realm {realm}: {ex}", file=sys.stderr)
                idprealm.ensure_federation(kc, realm)
        else:
            print(agent.SD_WARNING + f"User domain {realm} not found: the LDAP federation of its realm is not updated", file=sys.stderr)

        clients = []
        for client in idprealm.module_clients(kc, realm):
            module_id = client["attributes"][idprealm.MODULE_ATTRIBUTE]
            if realm not in (rdb.hget("cluster/module_domains", module_id) or "").split():
                print(f"Deleting client {client['clientId']} of realm {realm}: module {module_id} is not bound to the user domain", file=sys.stderr)
                kc.delete(f"/{realm}/clients/{client['id']}")
            else:
                clients.append(client)
        idpaccess.reconcile(kc, realm, clients)

        print(f"Applying SMTP settings to realm {realm}", file=sys.stderr)
        kc.put(f"/{realm}", {"smtpServer": smtp_server})
        if idpcert.enabled(kc.get('/' + idpcert.path(realm))):
            certificate_realms.append(realm)

    if certificate_realms:
        from idp_routes import certificate_transport
        # Repair routes after restore/update and rebind a flow which a legacy
        # cleanup may have reset. A missing proxy capability must not stop the
        # other realms: get-certificates reports them as not operational.
        try:
            certificate_transport(True)
            for realm in certificate_realms:
                try:
                    idpcert.set_enabled(kc, realm, True, idpcert.proxy_secret())
                except idpcert.CertificateError as ex:
                    print(agent.SD_WARNING + f"Certificate sign-in of realm {realm} is not operational: {ex}", file=sys.stderr)
        except idpcert.CertificateError as ex:
            print(agent.SD_WARNING + f"Certificate sign-in transport is not operational: {ex}", file=sys.stderr)
